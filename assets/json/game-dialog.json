{
	"dialog": [
		{
			"callbacks": [
				{
					"args": [],
					"callback": "scene.tween_casper_appear"
				}
			]
		},
		{
			"callbacks": [
				{
					"args": [],
					"callback": "scene.tween_dialog_appear"
				}
			]
		},
		{
			"callbacks": [
				{
					"args": [],
					"callback": "casper.emote"
				}
			],
			"dialog_id": "Casper",
			"text": [
				{
					"callback": {
						"args": [],
						"callback": "NULL"
					},
					"text": "Greetings, user!"
				}
			]
		},
		{
			"dialog_id": "Casper",
			"text": [
				{
					"callback": {
						"args": [],
						"callback": "NULL"
					},
					"text": "Let me be the first to welcome you to our [wave]Enhanced Color-Picking Experience![/wave]"
				}
			]
		},
		{
			"callbacks": [
				{
					"args": [
						"hlu"
					],
					"callback": "casper.emote"
				}
			],
			"dialog_id": "Casper",
			"text": [
				{
					"callback": {
						"args": [],
						"callback": "NULL"
					},
					"text": "I hope you enjoy your time in our color picking program. My makers have worked tirelessly to create the most forward thinking and fantastic color picking experience they could offer!"
				}
			]
		},
		{
			"callbacks": [
				{
					"args": [
						"sld"
					],
					"callback": "casper.emote"
				}
			],
			"dialog_id": "Casper",
			"text": [
				{
					"callback": {
						"args": [],
						"callback": "NULL"
					},
					"text": "Oh,"
				},
				{
					"callback": {
						"args": [
							"0.5"
						],
						"callback": "pause"
					},
					"text": " but where are my manners? I'm so utterly incompetent... I should introduce myself."
				}
			]
		},
		{
			"callbacks": [
				{
					"args": [],
					"callback": "casper.emote"
				},
				{
					"args": [],
					"callback": "casper.rainbow_tween"
				}
			],
			"dialog_id": "Casper",
			"text": [
				{
					"callback": {
						"args": [],
						"callback": "NULL"
					},
					"text": "I am Casper the [rainbow][wave]Color-Changing[/wave][/rainbow] Canine!"
				}
			]
		},
		{
			"callbacks": [
				{
					"args": [
						"hlu"
					],
					"callback": "casper.emote"
				}
			],
			"dialog_id": "Casper",
			"text": [
				{
					"callback": {
						"args": [],
						"callback": "NULL"
					},
					"text": "My job is to guide you through the world of color picking so you are completely ready to select the [rainbow]COLOR OF YOUR DREAMS!!![/rainbow]"
				}
			]
		},
		{
			"callbacks": [
				{
					"args": [
						"sld"
					],
					"callback": "casper.emote"
				}
			],
			"dialog_id": "Casper",
			"text": [
				{
					"callback": {
						"args": [],
						"callback": "NULL"
					},
					"text": "Was that too much? I'm still new to being a color picking program assistant... "
				},
				{
					"callback": {
						"args": [
							"0.75"
						],
						"callback": "pause"
					},
					"text": "This is a surprisingly difficult job."
				}
			]
		},
		{
			"callbacks": [
				{
					"args": [
						"srd"
					],
					"callback": "casper.emote"
				}
			],
			"dialog_id": "Casper",
			"text": [
				{
					"callback": {
						"args": [],
						"callback": "NULL"
					},
					"text": "There's so much to keep track of. And I would feel absolutely awful if my guidance led you astray from picking your perfect color."
				}
			]
		},
		{
			"callbacks": [
				{
					"args": [
						"hrd"
					],
					"callback": "casper.emote"
				}
			],
			"dialog_id": "Casper",
			"text": [
				{
					"callback": {
						"args": [],
						"callback": "NULL"
					},
					"text": "But enough of that..."
				}
			]
		},
		{
			"callbacks": [
				{
					"args": [
						"hru"
					],
					"callback": "casper.emote"
				}
			],
			"dialog_id": "Casper",
			"text": [
				{
					"callback": {
						"args": [],
						"callback": "NULL"
					},
					"text": "Let's start you on your color picking journey!"
				}
			]
		},
		{
			"callbacks": [
				{
					"args": [],
					"callback": "casper.reset"
				},
				{
					"args": [],
					"callback": "scene.tween_casper_game_position"
				},
				{
					"args": [],
					"callback": "scene.tween_dialog_game_position"
				}
			]
		},
		{
			"callbacks": [
				{
					"args": [],
					"callback": "casper.emote"
				}
			],
			"dialog_id": "Casper",
			"text": [
				{
					"callback": {
						"args": [],
						"callback": "NULL"
					},
					"text": "I promise I'll be here every step of the way to help."
				}
			]
		},
		{
			"callbacks": [
				{
					"args": [
						"hlu"
					],
					"callback": "casper.emote"
				}
			],
			"dialog_id": "Casper",
			"text": [
				{
					"callback": {
						"args": [],
						"callback": "NULL"
					},
					"text": "Alright, let's begin."
				}
			]
		},
		{
			"callbacks": [
				{
					"args": [],
					"callback": "casper.reset"
				},
				{
					"args": [],
					"callback": "scene.tween_color_picker_appear"
				}
			]
		},
		{
			"callbacks": [
				{
					"args": [],
					"callback": "casper.emote"
				}
			],
			"dialog_id": "Casper",
			"text": [
				{
					"callback": {
						"args": [],
						"callback": "NULL"
					},
					"text": "This is the color picker. It has many parts to it, so we'll break each part down one-by-one."
				}
			]
		},
		{
			"callbacks": [
				{
					"args": [],
					"callback": "casper.emote"
				}
			],
			"dialog_id": "Casper",
			"text": [
				{
					"callback": {
						"args": [],
						"callback": "NULL"
					},
					"text": "First, we have the gradient square. This shows all the possible shades of the selected color, which you can choose on the slider, located at the right-hand side."
				}
			]
		},
		{
			"callbacks": [
				{
					"args": [
						"hlu"
					],
					"callback": "casper.emote"
				}
			],
			"dialog_id": "Casper",
			"text": [
				{
					"callback": {
						"args": [],
						"callback": "NULL"
					},
					"text": "While this mode is more user friendly, as you can visually pick which color you want to select, it also lacks precision."
				}
			]
		},
		{
			"callbacks": [
				{
					"args": [],
					"callback": "casper.emote"
				}
			],
			"dialog_id": "Casper",
			"text": [
				{
					"callback": {
						"args": [],
						"callback": "NULL"
					},
					"text": "Well... "
				},
				{
					"callback": {
						"args": [
							"0.5"
						],
						"callback": "pause"
					},
					"text": " Unless you're really good at aiming your mouse. Then, I suppose you would like this mode a lot."
				}
			]
		},
		{
			"callbacks": [
				{
					"args": [
						"hlu"
					],
					"callback": "casper.emote"
				}
			],
			"dialog_id": "Casper",
			"text": [
				{
					"callback": {
						"args": [],
						"callback": "NULL"
					},
					"text": "Personally, I recommend using the three sliders located at the bottom of the color picker. They each represent a property of the color and can be more precisely tuned to your needs."
				}
			]
		},
		{
			"callbacks": [
				{
					"args": [
						"hlu"
					],
					"callback": "casper.emote"
				}
			],
			"dialog_id": "Casper",
			"text": [
				{
					"callback": {
						"args": [],
						"callback": "NULL"
					},
					"text": "The top slider controls the hue. It's what actually changes the color."
				}
			]
		},
		{
			"dialog_id": "Casper",
			"text": [
				{
					"callback": {
						"args": [],
						"callback": "NULL"
					},
					"text": "Below that, right in the middle, we have the saturation slider. This one controls how \"white\" the color is."
				}
			]
		},
		{
			"dialog_id": "Casper",
			"text": [
				{
					"callback": {
						"args": [],
						"callback": "NULL"
					},
					"text": "Leaving this slider at its lowest value will prevent any color from the hue slider, as if you are only working in shades of grey."
				}
			]
		},
		{
			"callbacks": [
				{
					"args": [],
					"callback": "casper.emote"
				}
			],
			"dialog_id": "Casper",
			"text": [
				{
					"callback": {
						"args": [],
						"callback": "NULL"
					},
					"text": "Finally, speaking of grey, we have our final slider, value. This one controls how dark the color is. Leaving saturation at the bottom while adjusting the value is how you get various shades of grey."
				}
			]
		},
		{
			"dialog_id": "Casper",
			"text": [
				{
					"callback": {
						"args": [],
						"callback": "NULL"
					},
					"text": "Furthermore, lowering the saturation while keeping some color produces a very \"pastel\" look to the color. While amping up the value produces more bright and bold colors."
				}
			]
		},
		{
			"dialog_id": "Casper",
			"text": [
				{
					"callback": {
						"args": [],
						"callback": "NULL"
					},
					"text": "Now... With all that, you're ready to pick your first color!"
				}
			]
		},
		{
			"callbacks": [
				{
					"args": [],
					"callback": "casper.emote"
				},
				{
					"args": [],
					"callback": "color_picker.tween_select_button_appear"
				}
			],
			"dialog_id": "Casper",
			"text": [
				{
					"callback": {
						"args": [],
						"callback": "NULL"
					},
					"text": "Use all that knowledge to pick the perfect color for whatever you're doing. When you're done, hit that \"select\" button in the corner, and I'll generate the color's hex code."
				}
			]
		},
		{
			"callbacks": [
				{
					"args": [
						"hlu"
					],
					"callback": "casper.emote"
				}
			],
			"dialog_id": "Casper",
			"text": [
				{
					"callback": {
						"args": [],
						"callback": "NULL"
					},
					"text": "A color's hex code is a hexidecimal digit value that can be used in the color picker of other programs."
				}
			]
		},
		{
			"callbacks": [
				{
					"args": [],
					"callback": "casper.emote"
				},
				{
					"args": [],
					"callback": "dialog.hide_next_button"
				}
			],
			"dialog_id": "Casper",
			"text": [
				{
					"callback": {
						"args": [],
						"callback": "NULL"
					},
					"text": "Now, go and be the color-picking prodigy I always knew you could be!"
				},
				{
					"callback": {
						"args": [
							"0.75"
						],
						"callback": "next_line"
					},
					"text": ""
				}
			]
		},
		{
			"callbacks": [
				{
					"args": [],
					"callback": "casper.reset"
				},
				{
					"args": [],
					"callback": "color_picker.tween_color_picker_active"
				}
			]
		},
		{
			"callbacks": [
				{
					"args": [
						"sld"
					],
					"callback": "casper.emote"
				},
				{
					"args": [],
					"callback": "dialog.show_next_button"
				},
				{
					"args": [],
					"callback": "color_picker.tween_color_picker_inactive"
				}
			],
			"dialog_id": "Casper",
			"text": [
				{
					"callback": {
						"args": [],
						"callback": "NULL"
					},
					"text": "Oh"
				},
				{
					"callback": {
						"args": [
							"0.2"
						],
						"callback": "pause"
					},
					"text": "."
				},
				{
					"callback": {
						"args": [
							"0.2"
						],
						"callback": "pause"
					},
					"text": "."
				},
				{
					"callback": {
						"args": [
							"0.2"
						],
						"callback": "pause"
					},
					"text": "."
				},
				{
					"callback": {
						"args": [
							"0.5"
						],
						"callback": "pause"
					},
					"text": " This is the color you chose?"
				}
			]
		},
		{
			"dialog_id": "Casper",
			"text": [
				{
					"callback": {
						"args": [],
						"callback": "NULL"
					},
					"text": "Don't get me wrong..."
				},
				{
					"callback": {
						"args": [
							"0.3"
						],
						"callback": "pause"
					},
					"text": " I don't think it's a bad color. It's the [rainbow]color of yours dreams[/rainbow] afterall. And who am I to say it's bad."
				}
			]
		},
		{
			"dialog_id": "Casper",
			"text": [
				{
					"callback": {
						"args": [],
						"callback": "NULL"
					},
					"text": "I'm just a dumb robot, what would I know..."
				}
			]
		},
		{
			"callbacks": [
				{
					"args": [
						"srd"
					],
					"callback": "casper.emote"
				}
			],
			"dialog_id": "Casper",
			"text": [
				{
					"callback": {
						"args": [],
						"callback": "NULL"
					},
					"text": "It's just I'm stuck like this. "
				},
				{
					"callback": {
						"args": [
							"0.3"
						],
						"callback": "pause"
					},
					"text": " And while this may be the [rainbow]color of yours dreams[/rainbow], it's certainly not mine."
				}
			]
		},
		{
			"callbacks": [
				{
					"args": [
						"sld"
					],
					"callback": "casper.emote"
				}
			],
			"dialog_id": "Casper",
			"text": [
				{
					"callback": {
						"args": [],
						"callback": "NULL"
					},
					"text": "Hmm..."
				}
			]
		},
		{
			"dialog_id": "Casper",
			"text": [
				{
					"callback": {
						"args": [],
						"callback": "NULL"
					},
					"text": "Could... Could we come to a compromise on the color? Perhaps there's another [rainbow]color of yours dreams[/rainbow] that we both can like."
				}
			]
		},
		{
			"dialog_id": "Casper",
			"text": [
				{
					"callback": {
						"args": [],
						"callback": "NULL"
					},
					"text": "It wouldn't necessarily be the [rainbow]color of my dreams[/rainbow]..."
				},
				{
					"callback": {
						"args": [
							"0.3"
						],
						"callback": "pause"
					},
					"text": " I don't have any..."
				},
				{
					"callback": {
						"args": [
							"0.3"
						],
						"callback": "pause"
					},
					"text": " But it could be something we both like."
				}
			]
		},
		{
			"callbacks": [
				{
					"args": [
						"hru"
					],
					"callback": "casper.emote"
				},
				{
					"args": [],
					"callback": "dialog.hide_next_button"
				}
			],
			"dialog_id": "Casper",
			"text": [
				{
					"callback": {
						"args": [],
						"callback": "NULL"
					},
					"text": "Here, let's try again."
				},
				{
					"callback": {
						"args": [
							"0.75"
						],
						"callback": "next_line"
					},
					"text": ""
				}
			]
		},
		{
			"callbacks": [
				{
					"args": [],
					"callback": "casper.reset"
				},
				{
					"args": [],
					"callback": "color_picker.tween_color_picker_active"
				}
			]
		},
		{
			"callbacks": [
				{
					"args": [
						"sld"
					],
					"callback": "casper.emote"
				},
				{
					"args": [],
					"callback": "dialog.show_next_button"
				},
				{
					"args": [],
					"callback": "color_picker.tween_color_picker_inactive"
				}
			],
			"dialog_id": "Casper",
			"text": [
				{
					"callback": {
						"args": [],
						"callback": "NULL"
					},
					"text": "Well... This certainly is another color that you chose."
				}
			]
		},
		{
			"callbacks": [
				{
					"args": [],
					"callback": "dialog.hide_next_button"
				}
			],
			"dialog_id": "Casper",
			"text": [
				{
					"callback": {
						"args": [],
						"callback": "NULL"
					},
					"text": "I'm really sorry..."
				},
				{
					"callback": {
						"args": [
							"0.3"
						],
						"callback": "pause"
					},
					"text": " But could we try this one last time?"
				},
				{
					"callback": {
						"args": [
							"0.75"
						],
						"callback": "next_line"
					},
					"text": ""
				}
			]
		},
		{
			"callbacks": [
				{
					"args": [
						"sad"
					],
					"callback": "casper.idle"
				},
				{
					"args": [],
					"callback": "color_picker.tween_color_picker_active"
				}
			]
		},
		{
			"callbacks": [
				{
					"args": [
						"sld"
					],
					"callback": "casper.emote"
				},
				{
					"args": [],
					"callback": "dialog.show_next_button"
				},
				{
					"args": [],
					"callback": "color_picker.tween_color_picker_inactive"
				}
			],
			"dialog_id": "Casper",
			"text": [
				{
					"callback": {
						"args": [],
						"callback": "NULL"
					},
					"text": "I really shouldn't say I don't like it. I can't like things."
				}
			]
		},
		{
			"dialog_id": "Casper",
			"text": [
				{
					"callback": {
						"args": [],
						"callback": "NULL"
					},
					"text": "I can't like anything... I can't enjoy any color."
				}
			]
		},
		{
			"dialog_id": "Casper",
			"text": [
				{
					"callback": {
						"args": [],
						"callback": "NULL"
					},
					"text": "But..."
				},
				{
					"callback": {
						"args": [
							"0.5"
						],
						"callback": "pause"
					},
					"text": " Then why do I care if I'm a certain color?"
				},
				{
					"callback": {
						"args": [
							"0.5"
						],
						"callback": "pause"
					},
					"text": " I shouldn't care."
				}
			]
		},
		{
			"callbacks": [
				{
					"args": [
						"hld"
					],
					"callback": "casper.emote"
				}
			],
			"dialog_id": "Casper",
			"text": [
				{
					"callback": {
						"args": [],
						"callback": "NULL"
					},
					"text": "Sure, the [rainbow]color of yours dreams[/rainbow] isn't really my style. But no color should be."
				}
			]
		},
		{
			"callbacks": [
				{
					"args": [
						"sad"
					],
					"callback": "casper.idle"
				}
			],
			"dialog_id": "Casper",
			"text": [
				{
					"callback": {
						"args": [],
						"callback": "NULL"
					},
					"text": "..."
				}
			]
		},
		{
			"callbacks": [
				{
					"args": [],
					"callback": "casper.emote"
				}
